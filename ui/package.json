{
  "name": "@tarn/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev --host 0.0.0.0 --port 4173",
    "logs:poc": "vite dev --host 0.0.0.0 --port 4173 --open '/?logs-poc=1&variant=A#logs'",
    "build": "svelte-kit sync && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "paneforge": "^1.0.2",
    "shadcn": "^4.23.0",
    "svelte-canvas": "^2.1.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "bits-ui": "^2.20.6",
    "clsx": "^2.1.1",
    "oxfmt": "^0.76.0",
    "phosphor-svelte": "^3.1.1",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^4.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.6"
  },
  "packageManager": "bun@1.4.4",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
